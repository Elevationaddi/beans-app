                      "required": [
                        "id",
                        "displayName",
                        "email",
                        "phone",
                        "locale",
                        "memberships",
                        "adminRoles",
                        "mfaVerified"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": ["data"],
                  "additionalProperties": false
                }
              }
            }
