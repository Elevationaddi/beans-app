{
  "openapi": "3.1.0",
  "info": {
    "title": "Coffee Marketplace API",
    "version": "0.2.0",
    "description": "Generated from packages/contracts/src/api/routes.ts. Amounts are integer fils encoded as decimal strings; timestamps are RFC 3339 UTC."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase Auth access token. Admin routes also need an aal2 (MFA) session."
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "BAD_REQUEST",
                  "VALIDATION_FAILED",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "MFA_REQUIRED",
                  "ACCOUNT_SUSPENDED",
                  "NOT_FOUND",
                  "CONFLICT",
                  "IDEMPOTENCY_KEY_REQUIRED",
                  "IDEMPOTENCY_CONFLICT",
                  "REQUEST_IN_PROGRESS",
                  "RATE_LIMITED",
                  "SERVICE_UNAVAILABLE",
                  "INTERNAL_ERROR",
                  "PRICE_CHANGED",
                  "OUT_OF_STOCK",
                  "BRANCH_CLOSED",
                  "SLOT_FULL",
                  "QUOTE_EXPIRED",
                  "INVALID_TRANSITION",
                  "PAYMENT_PENDING",
                  "PAYMENT_FAILED",
                  "FEATURE_DISABLED",
                  "REFUND_LIMIT"
                ]
              },
              "message": {
                "type": "string"
              },
              "fieldErrors": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": ["code", "message", "requestId"],
            "additionalProperties": false
          }
        },
        "required": ["error"],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Readiness: database and Redis reachable",
        "tags": ["Health"],
        "x-access": {
          "kind": "public"
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok", "degraded"]
                    },
                    "version": {
                      "type": "string"
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "database": {
                          "type": "string",
                          "enum": ["up", "down"]
                        },
                        "redis": {
                          "type": "string",
                          "enum": ["up", "down"]
                        }
                      },
                      "required": ["database", "redis"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["status", "version", "time", "checks"],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": ["ok", "degraded"]
                    },
                    "version": {
                      "type": "string"
                    },
                    "time": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    },
                    "checks": {
                      "type": "object",
                      "properties": {
                        "database": {
                          "type": "string",
                          "enum": ["up", "down"]
                        },
                        "redis": {
                          "type": "string",
                          "enum": ["up", "down"]
                        }
                      },
                      "required": ["database", "redis"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["status", "version", "time", "checks"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "summary": "Liveness: the process is running",
        "tags": ["Health"],
        "x-access": {
          "kind": "public"
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    }
                  },
                  "required": ["status"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
