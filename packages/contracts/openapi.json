    "/v1/merchant/branches": {
      "get": {
        "operationId": "listMerchantBranches",
        "summary": "Branches the caller may operate, across their merchants",
        "tags": ["Merchant"],
        "x-access": {
          "kind": "merchant",
          "note": "Owners see every branch of their merchants; other roles see assigned branches."
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          "merchantId": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                          },
                          "nameEn": {
                            "type": "string"
                          },
                          "nameAr": {
                            "type": ["string", "null"]
                          },
                          "address": {
                            "type": "string"
                          },
                          "timezone": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string",
                            "enum": ["draft", "active", "paused", "closed"]
                          },
                          "modes": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": ["in_store", "curbside", "dine_in"]
                            }
                          },
                          "capacity": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "hours": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "weekday": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 7
                                },
                                "opens": {
                                  "type": "string",
                                  "pattern": "^\\d{2}:\\d{2}$"
                                },
                                "closes": {
                                  "type": "string",
                                  "pattern": "^\\d{2}:\\d{2}$"
                                }
                              },
                              "required": ["weekday", "opens", "closes"],
                              "additionalProperties": false
                            }
                          }
                        },
                        "required": [
                          "id",
                          "merchantId",
                          "nameEn",
                          "nameAr",
                          "address",
                          "timezone",
                          "status",
                          "modes",
                          "capacity",
                          "hours"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "nextCursor": {
                          "type": ["string", "null"]
                        }
                      },
                      "required": ["nextCursor"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["data", "meta"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired access token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated but not permitted (role, MFA or account status)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ]
      }
    },
