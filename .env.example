# Copy to apps/api/.env for local development. Placeholders only: never commit real values.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://beans:beans@localhost:5432/beans
REDIS_URL=redis://localhost:6379
# Comma-separated browser origins allowed to call the API (merchant portal, admin console).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8081

# Supabase Auth (local or test project only). Leave empty and every signed-in request
# answers 401. Required in production.
SUPABASE_URL=
# Asymmetric signing keys only, e.g. http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Expected token issuer, e.g. http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Public key, safe for clients. The service role key is server-only and not needed.
SUPABASE_ANON_KEY=

# Publish transactional outbox rows to BullMQ, and consume them (file checks), in this process.
OUTBOX_RELAY_ENABLED=true
OUTBOX_WORKER_ENABLED=true

# Files. Development adapters only: local disk storage and a basic file checker. Both are
# refused in production until a storage provider and malware scanner are chosen.
API_PUBLIC_URL=http://localhost:3000
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
FILE_SCANNER=basic
# 32+ random characters; unset = random per process (links break on restart). Required in production.
FILE_SIGNING_SECRET=

# Payments. Only the fake (sandbox) provider exists; live payments stay blocked until
# decisions D02-D08 are approved.
PAYMENT_PROVIDER=fake
LIVE_PAYMENTS_ENABLED=false
# Webhook signing secret, 32+ random characters. Unset = random per process. Required in production.
PAYMENT_WEBHOOK_SECRET=

# Phase 6: checkout. Sandbox values: quote validity and how long a checkout holds a slot
# place and stock while payment completes. Confirm before launch.
QUOTE_TTL_SECONDS=300
RESERVATION_TTL_SECONDS=600
# Background payment sweep in this process: retry webhooks, poll pending payments, release
# expired holds, retry approved refunds and payouts, cancel orders not accepted in time.
CHECKOUT_SWEEP_ENABLED=true

# Phase 8: fulfilment. Sandbox D10: a branch has 120 s to accept a paid order, otherwise it is
# cancelled and refunded automatically. Confirm the real SLA before launch.
ACCEPT_TIMEOUT_SECONDS=120
# Handoff (pickup) code secret, 32+ random characters. Unset = random per process, so codes
# of open orders stop matching after a restart. Required in production.
PICKUP_CODE_SECRET=

# Dine-in table QR token secret, 32+ random characters. Unset = random per process, so printed
# table codes stop working after a restart. Required in production. Rotating it voids all codes.
TABLE_TOKEN_SECRET=

# Phase 11: per-user / per-IP limits on sensitive routes. Cannot be false in production.
RATE_LIMIT_ENABLED=true

# Local development sign-in for the fictional seed accounts (D12). Lets every protected screen
# be used without Supabase credentials. Refused with NODE_ENV=production. Keep false anywhere
# reachable from the internet.
DEV_AUTH_ENABLED=true
