# Copy to apps/api/.env for local development. Placeholders only: never commit real values.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://beans:beans@localhost:5432/beans
REDIS_URL=redis://localhost:6379
# Comma-separated browser origins allowed to call the API (merchant portal, admin console).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Supabase Auth (local or test project only). Leave empty and every signed-in request
# answers 401. Required in production.
SUPABASE_URL=
# Asymmetric signing keys only, e.g. http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Expected token issuer, e.g. http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Public key, safe for clients. The service role key is server-only and not needed.
SUPABASE_ANON_KEY=

# Publish transactional outbox rows to BullMQ from this process.
OUTBOX_RELAY_ENABLED=true

# Phase 7: payments. Only the fake provider exists; live payments stay blocked until
# decisions D02-D08 are approved.
PAYMENT_PROVIDER=fake
LIVE_PAYMENTS_ENABLED=false
