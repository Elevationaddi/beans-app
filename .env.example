# Copy to apps/api/.env for local development. Placeholders only: never commit real values.
NODE_ENV=development
# local | staging | production. With NODE_ENV=production it must be staging or production;
# only private staging may use the sandbox payment provider (PAYMENT_PROVIDER=fake).
DEPLOY_ENV=local
PORT=3000
DATABASE_URL=postgresql://beans:beans@localhost:5432/beans
# Connections per API instance. On Vercel use 1-3 with Supabase's transaction pooler
# (port 6543, append ?pgbouncer=true) and set DIRECT_URL for migrations.
DATABASE_POOL_MAX=10
# Migrations only (prisma migrate deploy): a direct or session-mode connection. Not used at runtime.
DIRECT_URL=
# Comma-separated browser origins allowed to call the API (merchant portal, admin console).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:8081

# Supabase Auth (local or test project only). Leave empty and every signed-in request
# answers 401. Required in production.
SUPABASE_URL=
# Asymmetric signing keys only, e.g. http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Expected token issuer, e.g. http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Public key, safe for clients.
SUPABASE_ANON_KEY=
# Server-only secret: Realtime broadcasts and the Supabase Storage driver. Never in a client build.
SUPABASE_SERVICE_ROLE_KEY=

# Live order updates: "memory" (this process; local development) or "supabase" (Realtime
# Broadcast; required on Vercel). The channel secret makes channel names unguessable (32+ chars).
REALTIME_DRIVER=memory
REALTIME_CHANNEL_SECRET=

# Background work. The database is the job queue (no Redis). Long-running servers can poll;
# on Vercel set OUTBOX_RELAY_ENABLED=false and CHECKOUT_SWEEP_ENABLED=false and let Vercel Cron
# call /v1/internal/cron/tick every minute with "Authorization: Bearer $CRON_SECRET".
OUTBOX_KICK_ENABLED=true
OUTBOX_RELAY_ENABLED=true
# 32+ random characters. Required in production; without it the cron route answers 404.
CRON_SECRET=

# Files. STORAGE_DRIVER: "local" (this disk, development) or "supabase" (a PRIVATE Supabase
# Storage bucket; needs SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY; create the bucket once with
# `pnpm --filter @beans/api storage:setup`). FILE_SCANNER: "basic" (development checker, NOT a
# malware scanner; refused in production) or "disabled" (document uploads are refused; use this in
# staging and production until a real scanner is approved, docs/27 L1).
API_PUBLIC_URL=http://localhost:3000
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
SUPABASE_STORAGE_BUCKET=merchant-documents
FILE_SCANNER=basic
# 32+ random characters; unset = random per process (links break on restart). Required in production.
FILE_SIGNING_SECRET=

# Payments: "fake" (in-memory sandbox, default) or "tap" (Tap Payments with TEST keys only;
# sk_live_ keys are refused). Live payments stay blocked until decisions D02-D08 are approved.
PAYMENT_PROVIDER=fake
# Tap test secret key (sk_test_...) from the Tap dashboard. Never commit a real value.
TAP_SECRET_KEY=
# Where Tap's hosted payment page sends the customer back (the customer app).
TAP_RETURN_URL=
LIVE_PAYMENTS_ENABLED=false
# Webhook signing secret, 32+ random characters. Unset = random per process. Required in production.
PAYMENT_WEBHOOK_SECRET=

# Phase 6: checkout. Sandbox values: quote validity and how long a checkout holds a slot
# place and stock while payment completes. Confirm before launch.
QUOTE_TTL_SECONDS=300
RESERVATION_TTL_SECONDS=600
# Background payment sweep in this process: retry webhooks, poll pending payments, release
# expired holds, retry approved refunds and payouts, cancel orders not accepted in time.
CHECKOUT_SWEEP_ENABLED=true

# Phase 8: fulfilment. Sandbox D10: a branch has 120 s to accept a paid order, otherwise it is
# cancelled and refunded automatically. Confirm the real SLA before launch.
ACCEPT_TIMEOUT_SECONDS=120
# Handoff (pickup) code secret, 32+ random characters. Unset = random per process, so codes
# of open orders stop matching after a restart. Required in production.
PICKUP_CODE_SECRET=

# Dine-in table QR token secret, 32+ random characters. Unset = random per process, so printed
# table codes stop working after a restart. Required in production. Rotating it voids all codes.
TABLE_TOKEN_SECRET=

# Phase 11: per-user / per-IP limits on sensitive routes. Cannot be false in production.
RATE_LIMIT_ENABLED=true

# Local development sign-in for the fictional seed accounts (D12). Lets every protected screen
# be used without Supabase credentials. Refused with NODE_ENV=production. Keep false anywhere
# reachable from the internet.
DEV_AUTH_ENABLED=true
