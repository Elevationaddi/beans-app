// Prisma schema for the coffee marketplace. Contract: docs/06-database-schema.md.
//
// Phase 2 creates the identity, tenancy, catalog and platform tables. Order, payment,
// finance, support and phase-two tables arrive in the phases that use them.
// Constraints Prisma cannot express (CHECKs, composite tenant FKs, append-only triggers,
// partial indexes) live in the SQL migrations; see prisma/migrations/*/migration.sql.
//
// Money is always BigInt fils. Timestamps are timestamptz (UTC).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Identity ─────────────────────────────

enum Locale {
  en
  ar
}

enum UserStatus {
  active
  suspended
  deleted
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  /// Subject ("sub") of the verified Supabase access token.
  authSubject String     @unique @map("auth_subject")
  displayName String?    @map("display_name")
  email       String?
  phone       String?
  locale      Locale     @default(en)
  status      UserStatus @default(active)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships           Membership[]
  adminRoles            AdminRole[]
  auditEvents           AuditEvent[]
  uploads               Upload[]
  policiesApproved      Policy[]                  @relation("PolicyApprover")
  invitationsSent       StaffInvitation[]         @relation("InvitationInviter")
  invitationsAccepted   StaffInvitation[]         @relation("InvitationAcceptor")
  favorites             Favorite[]
  vehicles              Vehicle[]
  carts                 Cart[]
  quotes                Quote[]
  orders                Order[]
  orderEvents           OrderEvent[]
  refundsRequested      Refund[]                  @relation("RefundRequester")
  refundsDecided        Refund[]                  @relation("RefundDecider")
  payoutsMade           Payout[]                  @relation("PayoutMaker")
  payoutsChecked        Payout[]                  @relation("PayoutChecker")
  exceptionsResolved    ReconciliationException[]
  arrivalsAcknowledged  Order[]                   @relation("OrderArrivalAck")
  cancellationRequests  CancellationRequest[]     @relation("CancellationRequester")
  cancellationsResolved CancellationRequest[]     @relation("CancellationResolver")
  ticketsRequested      Ticket[]                  @relation("TicketRequester")
  ticketsAssigned       Ticket[]                  @relation("TicketAssignee")
  settingsUpdated       PlatformSetting[]         @relation("SettingUpdater")
  notifications         Notification[]
  stampAccounts         StampAccount[]
  stampEvents           StampEvent[]
  promotionRedemptions  PromotionRedemption[]
  giftsBought           Gift[]                    @relation("GiftPurchaser")
  giftsReceived         Gift[]                    @relation("GiftRecipient")
  promotionsReviewed    Promotion[]               @relation("PromotionReviewer")
  ticketMessages        TicketMessage[]

  @@map("users")
}

enum AdminRoleName {
  super_admin
  operations
  finance_maker
  finance_checker
  support
  marketing
  analyst
  security
}

model AdminRole {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  role      AdminRoleName
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, role])
  @@map("admin_roles")
}

// ───────────────────────────── Tenancy ─────────────────────────────

enum MerchantStatus {
  draft
  submitted
  review
  approved
  rejected
  suspended
}

model Merchant {
  id                 String         @id @default(uuid()) @db.Uuid
  legalName          String         @map("legal_name")
  brandName          String         @map("brand_name")
  licenseNumber      String         @unique @map("license_number")
  status             MerchantStatus @default(draft)
  providerAccountRef String?        @map("provider_account_ref")
  /// Applicant contact: { "name", "email", "phone" }. Not in docs/06; needed by B01.
  contact            Json           @default("{}")
  /// Latest reviewer note shown to the applicant (e.g. requested corrections).
  reviewNote         String?        @map("review_note")
  submittedAt        DateTime?      @map("submitted_at") @db.Timestamptz(6)
  reviewedAt         DateTime?      @map("reviewed_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches       Branch[]
  memberships    Membership[]
  categories     Category[]
  products       Product[]
  modifierGroups ModifierGroup[]
  documents      MerchantDocument[]
  uploads        Upload[]
  invitations    StaffInvitation[]
  favoritedBy    Favorite[]
  journalLines   JournalLine[]
  payouts        Payout[]
  stampCard      StampCard?
  stampAccounts  StampAccount[]
  promotions     Promotion[]
  gifts          Gift[]
  tickets        Ticket[]

  @@index([status, submittedAt])
  @@map("merchants")
}

enum BranchStatus {
  draft
  active
  paused
  closed
}

model Branch {
  id         String       @id @default(uuid()) @db.Uuid
  merchantId String       @map("merchant_id") @db.Uuid
  nameEn     String       @map("name_en")
  nameAr     String?      @map("name_ar")
  address    String
  lat        Decimal?     @db.Decimal(9, 6)
  lng        Decimal?     @db.Decimal(9, 6)
  timezone   String       @default("Asia/Dubai")
  status     BranchStatus @default(draft)
  /// Fulfilment modes offered: in_store, curbside, dine_in.
  modes      String[]
  /// Orders the branch can take per pickup slot.
  capacity   Int
  phone      String?
  /// UAE emirate slug (see contracts citySchema); null until the merchant sets it.
  city       String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant   Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  slots      Slot[]
  hours      BranchHour[]
  exceptions BranchException[]
  members    MembershipBranch[]
  products   BranchProduct[]
  options    BranchOption[]
  carts      Cart[]
  quotes     Quote[]
  tables     BranchTable[]
  orders     Order[]

  @@unique([id, merchantId])
  @@index([merchantId, status])
  @@index([city, status])
  @@map("branches")
}

model BranchHour {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  /// ISO weekday, 1 = Monday ... 7 = Sunday, in the branch timezone.
  weekday   Int
  opens     DateTime @db.Time(0)
  closes    DateTime @db.Time(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, weekday])
  @@map("branch_hours")
}

model BranchException {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  localDate DateTime @map("local_date") @db.Date
  closed    Boolean
  /// [{ "opens": "HH:MM", "closes": "HH:MM" }] when open with special hours.
  intervals Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, localDate])
  @@map("branch_exceptions")
}

enum MembershipRole {
  owner
  manager
  barista
  analyst
}

enum MembershipStatus {
  invited
  active
  revoked
}

model Membership {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  merchantId       String           @map("merchant_id") @db.Uuid
  role             MembershipRole
  status           MembershipStatus @default(active)
  /// Managers may edit the merchant-wide menu only when the owner delegates it (docs/10).
  catalogDelegated Boolean          @default(false) @map("catalog_delegated")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  merchant Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  branches MembershipBranch[]

  @@unique([userId, merchantId])
  @@unique([id, merchantId])
  @@index([merchantId])
  @@map("memberships")
}

/// Branch assignment. merchant_id is repeated so composite FKs guarantee the membership
/// and the branch belong to the same merchant.
model MembershipBranch {
  id           String @id @default(uuid()) @db.Uuid
  membershipId String @map("membership_id") @db.Uuid
  branchId     String @map("branch_id") @db.Uuid
  merchantId   String @map("merchant_id") @db.Uuid

  membership Membership @relation(fields: [membershipId, merchantId], references: [id, merchantId], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Cascade)

  @@unique([membershipId, branchId])
  @@index([branchId])
  @@map("membership_branches")
}

// ───────────────────────────── Files ─────────────────────────────

enum UploadPurpose {
  merchant_document
}

enum UploadStatus {
  /// Ticket issued, bytes not confirmed yet.
  pending
  /// Bytes received; waiting for the file check. Never served.
  quarantined
  /// Passed the file check. Downloadable through short-lived links only.
  clean
  /// Failed the file check or the declared type/size.
  rejected
}

/// A file uploaded to private object storage. The object key is generated by the server
/// and bound to the tenant; clients never choose it. Not in docs/06; required by the
/// /uploads endpoints in docs/07.
model Upload {
  id           String        @id @default(uuid()) @db.Uuid
  ownerId      String        @map("owner_id") @db.Uuid
  merchantId   String?       @map("merchant_id") @db.Uuid
  purpose      UploadPurpose
  objectKey    String        @unique @map("object_key")
  mime         String
  declaredSize Int           @map("declared_size")
  actualSize   Int?          @map("actual_size")
  sha256       String?
  status       UploadStatus  @default(pending)
  scanResult   String?       @map("scan_result")
  expiresAt    DateTime      @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner    User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  merchant Merchant?         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  document MerchantDocument?

  @@unique([id, merchantId])
  @@index([ownerId, createdAt])
  @@index([status, updatedAt])
  @@map("uploads")
}

enum MerchantDocumentType {
  trade_license
  owner_id
  vat_certificate
  other
}

enum DocumentReviewStatus {
  pending
  accepted
  rejected
}

model MerchantDocument {
  id           String               @id @default(uuid()) @db.Uuid
  merchantId   String               @map("merchant_id") @db.Uuid
  uploadId     String               @unique @map("upload_id") @db.Uuid
  type         MerchantDocumentType
  reviewStatus DocumentReviewStatus @default(pending) @map("review_status")
  /// Copy of uploads.object_key for the docs/06 contract; the upload row is authoritative.
  objectKey    String               @map("object_key")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  upload   Upload   @relation(fields: [uploadId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([uploadId, merchantId])
  @@index([merchantId])
  @@map("merchant_documents")
}

/// Pickup capacity per time window (docs/06). Generated from opening hours and exceptions.
model Slot {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  startsAt  DateTime @map("starts_at") @db.Timestamptz(6)
  capacity  Int
  reserved  Int      @default(0)
  confirmed Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  quotes       Quote[]
  reservations Reservation[]

  @@unique([branchId, startsAt])
  @@map("slots")
}

enum InvitationStatus {
  pending
  accepted
  revoked
}

/// Staff invitation (docs/03 B07). The token is shown once and stored only as a hash.
model StaffInvitation {
  id               String           @id @default(uuid()) @db.Uuid
  merchantId       String           @map("merchant_id") @db.Uuid
  email            String
  role             MembershipRole
  branchIds        String[]         @map("branch_ids") @db.Uuid
  catalogDelegated Boolean          @default(false) @map("catalog_delegated")
  tokenHash        String           @unique @map("token_hash")
  status           InvitationStatus @default(pending)
  invitedById      String           @map("invited_by") @db.Uuid
  acceptedById     String?          @map("accepted_by") @db.Uuid
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  invitedBy  User     @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User?    @relation("InvitationAcceptor", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([merchantId, status])
  @@map("staff_invitations")
}

// ───────────────────────────── Catalog ─────────────────────────────

model Category {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  nameEn     String   @map("name_en")
  nameAr     String?  @map("name_ar")
  sort       Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  products Product[]

  @@unique([id, merchantId])
  @@index([merchantId, sort])
  @@map("categories")
}

enum ProductStatus {
  draft
  published
  archived
}

model Product {
  id                 String        @id @default(uuid()) @db.Uuid
  merchantId         String        @map("merchant_id") @db.Uuid
  categoryId         String        @map("category_id") @db.Uuid
  /// { "en": "...", "ar": "..." }
  names              Json
  descriptions       Json          @default("{}")
  photoKey           String?       @map("photo_key")
  baseFils           BigInt        @map("base_fils")
  allergens          String[]
  status             ProductStatus @default(draft)
  version            Int           @default(1)
  /// Set by platform moderation (docs/04): hidden from customers whatever its status.
  moderationHiddenAt DateTime?     @map("moderation_hidden_at") @db.Timestamptz(6)
  moderationNote     String?       @map("moderation_note")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant   Merchant        @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  category   Category        @relation(fields: [categoryId, merchantId], references: [id, merchantId], onDelete: Restrict)
  groups     ProductGroup[]
  branches   BranchProduct[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  gifts Gift[]

  @@unique([id, merchantId])
  @@index([merchantId, categoryId, status])
  @@map("products")
}

model ModifierGroup {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  name       Json
  minCount   Int      @map("min_count")
  maxCount   Int      @map("max_count")
  sort       Int      @default(0)
  version    Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant         @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  options  ModifierOption[]
  products ProductGroup[]

  @@unique([id, merchantId])
  @@index([merchantId])
  @@map("modifier_groups")
}

model ModifierOption {
  id         String   @id @default(uuid()) @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  name       Json
  deltaFils  BigInt   @default(0) @map("delta_fils")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  group    ModifierGroup  @relation(fields: [groupId, merchantId], references: [id, merchantId], onDelete: Restrict)
  branches BranchOption[]

  @@unique([id, merchantId])
  @@index([groupId])
  @@map("modifier_options")
}

model ProductGroup {
  id         String @id @default(uuid()) @db.Uuid
  productId  String @map("product_id") @db.Uuid
  groupId    String @map("group_id") @db.Uuid
  merchantId String @map("merchant_id") @db.Uuid
  sort       Int    @default(0)

  product Product       @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [groupId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([productId, groupId])
  @@map("product_groups")
}

model BranchProduct {
  id                String   @id @default(uuid()) @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  merchantId        String   @map("merchant_id") @db.Uuid
  enabled           Boolean  @default(true)
  priceOverrideFils BigInt?  @map("price_override_fils")
  /// Null means stock is not tracked for this product at this branch.
  stockOnHand       Int?     @map("stock_on_hand")
  stockReserved     Int      @default(0) @map("stock_reserved")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch           Branch            @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  product          Product           @relation(fields: [productId, merchantId], references: [id, merchantId], onDelete: Restrict)
  reservationItems ReservationItem[]

  @@unique([branchId, productId])
  @@map("branch_products")
}

model BranchOption {
  id                String   @id @default(uuid()) @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  optionId          String   @map("option_id") @db.Uuid
  merchantId        String   @map("merchant_id") @db.Uuid
  enabled           Boolean  @default(true)
  deltaOverrideFils BigInt?  @map("delta_override_fils")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch         @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  option ModifierOption @relation(fields: [optionId, merchantId], references: [id, merchantId], onDelete: Restrict)

  @@unique([branchId, optionId])
  @@map("branch_options")
}

// ───────────────────────────── Platform ─────────────────────────────

/// Effective-dated commercial policy versions (decision register). Immutable once effective.
model Policy {
  id            String   @id @default(uuid()) @db.Uuid
  type          String
  version       String
  effectiveAt   DateTime @map("effective_at") @db.Timestamptz(6)
  configuration Json
  approvedById  String?  @map("approved_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  approvedBy User? @relation("PolicyApprover", fields: [approvedById], references: [id], onDelete: Restrict)

  @@unique([type, version])
  @@map("policies")
}

enum IdempotencyStatus {
  in_progress
  completed
}

model IdempotencyKey {
  id           String            @id @default(uuid()) @db.Uuid
  actorScope   String            @map("actor_scope")
  route        String
  key          String
  requestHash  String            @map("request_hash")
  status       IdempotencyStatus @default(in_progress)
  responseCode Int?              @map("response_code")
  response     Json?
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz(6)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([actorScope, route, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum OutboxState {
  pending
  dispatched
  failed
}

model OutboxMessage {
  id          String      @id @default(uuid()) @db.Uuid
  topic       String
  aggregateId String      @map("aggregate_id") @db.Uuid
  dedupeKey   String      @unique @map("dedupe_key")
  payload     Json
  state       OutboxState @default(pending)
  attempts    Int         @default(0)
  lastError   String?     @map("last_error")
  nextRunAt   DateTime    @default(now()) @map("next_run_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([state, nextRunAt])
  @@map("outbox")
}

/// Append-only. UPDATE and DELETE are rejected by a database trigger.
model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  targetType     String   @map("target_type")
  targetId       String   @map("target_id")
  reason         String?
  beforeRedacted Json?    @map("before_redacted")
  afterRedacted  Json?    @map("after_redacted")
  requestId      String   @map("request_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_events")
}

/// A café (merchant) a customer saved.
model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@unique([userId, merchantId])
  @@index([userId, createdAt])
  @@map("favorites")
}

// ───────────────────────────── Ordering ─────────────────────────────
// Phase 6: cart, quote, reservation (holds), pending order and sandbox payment attempts.
// Order and payment history is never deleted: every FK here is ON DELETE RESTRICT.

/// A customer's saved car for curbside pickup. Orders keep their own snapshot, so deleting
/// a vehicle never changes an order.
model Vehicle {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  plate       String
  plateRegion String?  @map("plate_region")
  color       String
  model       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("vehicles")
}

enum CartStatus {
  active
  converted
  abandoned
}

/// One branch per cart (F04). At most one active cart per customer (partial unique index).
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  branchId  String     @map("branch_id") @db.Uuid
  version   Int        @default(1)
  status    CartStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  items  CartItem[]
  quotes Quote[]

  @@index([userId, status])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  /// Chosen modifier option IDs, a JSON array of UUID strings (choices only, never prices).
  options   Json     @default("[]")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([cartId])
  @@map("cart_items")
}

enum OrderMode {
  in_store
  curbside
  dine_in
}

/// Server-priced snapshot of a cart version. Immutable (database trigger); holds nothing.
model Quote {
  id            String    @id @default(uuid()) @db.Uuid
  cartId        String    @map("cart_id") @db.Uuid
  cartVersion   Int       @map("cart_version")
  userId        String    @map("user_id") @db.Uuid
  branchId      String    @map("branch_id") @db.Uuid
  mode          OrderMode
  /// The pickup slot (ASAP resolves to the current slot).
  slotId        String    @map("slot_id") @db.Uuid
  totals        Json
  lineSnapshot  Json      @map("line_snapshot")
  fulfillment   Json
  menuVersion   String    @map("menu_version")
  policyVersion String    @map("policy_version")
  /// Reward, promotion or gift applied by the server (phase 9), with its discount.
  benefit       Json?
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  cart        Cart         @relation(fields: [cartId], references: [id], onDelete: Restrict)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  slot        Slot         @relation(fields: [slotId], references: [id], onDelete: Restrict)
  reservation Reservation?
  order       Order?

  @@index([expiresAt])
  @@index([userId, createdAt])
  @@map("quotes")
}

enum ReservationState {
  held
  committed
  released
}

/// Slot place and stock held for one checkout until payment is verified or the hold expires.
model Reservation {
  id        String           @id @default(uuid()) @db.Uuid
  quoteId   String           @unique @map("quote_id") @db.Uuid
  slotId    String           @map("slot_id") @db.Uuid
  state     ReservationState @default(held)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  quote Quote             @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  slot  Slot              @relation(fields: [slotId], references: [id], onDelete: Restrict)
  items ReservationItem[]
  order Order?

  @@index([state, expiresAt])
  @@map("reservations")
}

model ReservationItem {
  id              String @id @default(uuid()) @db.Uuid
  reservationId   String @map("reservation_id") @db.Uuid
  branchProductId String @map("branch_product_id") @db.Uuid
  quantity        Int

  reservation   Reservation   @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  branchProduct BranchProduct @relation(fields: [branchProductId], references: [id], onDelete: Restrict)

  @@unique([reservationId, branchProductId])
  @@map("reservation_items")
}

enum OrderStatus {
  pending_payment
  payment_failed
  received
  accepted
  rejected
  cancelled
  preparing
  ready
  completed
}

model Order {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String      @map("user_id") @db.Uuid
  branchId            String      @map("branch_id") @db.Uuid
  /// Derived from the branch on the server; composite FK keeps it consistent.
  merchantId          String      @map("merchant_id") @db.Uuid
  quoteId             String      @unique @map("quote_id") @db.Uuid
  reservationId       String      @unique @map("reservation_id") @db.Uuid
  publicNumber        String      @unique @map("public_number")
  status              OrderStatus @default(pending_payment)
  mode                OrderMode
  fulfillmentSnapshot Json        @map("fulfillment_snapshot")
  totals              Json
  /// Reward, promotion or gift applied by the server (phase 9), with its discount.
  benefit             Json?
  policyVersion       String      @map("policy_version")
  /// Salted hash of the handoff code, set when the order is received (docs/10).
  pickupCodeHash      String?     @map("pickup_code_hash")
  /// Wrong handoff codes in a row; locks completion for a while at the limit.
  pickupCodeFailures  Int         @default(0) @map("pickup_code_failures")
  pickupCodeLockedTil DateTime?   @map("pickup_code_locked_until") @db.Timestamptz(6)
  etaAt               DateTime?   @map("eta_at") @db.Timestamptz(6)
  /// Staff must accept before this (sandbox D10: 120 s after the order is received).
  acceptBy            DateTime?   @map("accept_by") @db.Timestamptz(6)
  /// Curbside check-in by the customer, then acknowledgement by staff (docs/08).
  arrivedAt           DateTime?   @map("arrived_at") @db.Timestamptz(6)
  arrivalAckAt        DateTime?   @map("arrival_ack_at") @db.Timestamptz(6)
  arrivalAckById      String?     @map("arrival_ack_by") @db.Uuid
  version             Int         @default(1)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch               Branch                @relation(fields: [branchId, merchantId], references: [id, merchantId], onDelete: Restrict)
  quote                Quote                 @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  reservation          Reservation           @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  events               OrderEvent[]
  payments             Payment[]
  refunds              Refund[]
  arrivalAckBy         User?                 @relation("OrderArrivalAck", fields: [arrivalAckById], references: [id], onDelete: Restrict)
  cancellationRequests CancellationRequest[]
  stampEvents          StampEvent[]
  promotionRedemption  PromotionRedemption?
  gift                 Gift?
  tickets              Ticket[]

  @@index([branchId, status, createdAt])
  @@index([status, acceptBy])
  @@index([userId, createdAt])
  @@map("orders")
}

/// Immutable line snapshot: names, options and prices as charged.
model OrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  /// Position on the order, from 1, as the customer arranged the cart.
  lineNo    Int      @map("line_no")
  productId String   @map("product_id") @db.Uuid
  quantity  Int
  snapshot  Json
  totalFils BigInt   @map("total_fils")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, lineNo])
  @@map("order_items")
}

/// Append-only order timeline (database trigger rejects UPDATE and DELETE).
model OrderEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  seq       Int
  fromState String?  @map("from_state")
  toState   String   @map("to_state")
  actorId   String?  @map("actor_id") @db.Uuid
  reason    String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@unique([orderId, seq])
  @@map("order_events")
}

enum PaymentStatus {
  pending
  captured
  failed
}

/// One provider payment attempt. The provider idempotency key is stable per attempt, so a
/// retried call can never create a second charge. No card data is ever stored.
model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  attempt     Int
  provider    String
  providerKey String        @unique @map("provider_key")
  providerRef String?       @unique @map("provider_ref")
  amountFils  BigInt        @map("amount_fils")
  currency    String        @db.Char(3)
  status      PaymentStatus @default(pending)
  failureCode String?       @map("failure_code")
  /// Provider hosted-page URL the customer must open to finish paying (Tap). Never card data.
  actionUrl   String?       @map("action_url")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds  Refund[]
  disputes Dispute[]

  @@unique([orderId, attempt])
  @@index([status, updatedAt])
  @@map("payments")
}

// ───────────────────────────── Payments and finance ─────────────────────────────
// Phase 7. Sandbox only: the fake provider is the only adapter and live payments stay
// blocked until decisions D02-D08 are approved. Financial history is append-only.

enum WebhookEventStatus {
  received
  processed
  ignored
  failed
}

/// Durable receipt of a verified provider webhook. The raw body is never stored, only its hash.
model PaymentWebhookEvent {
  id            String             @id @default(uuid()) @db.Uuid
  provider      String
  eventId       String             @map("event_id")
  type          String
  providerRef   String?            @map("provider_ref")
  payloadSha256 String             @map("payload_sha256")
  status        WebhookEventStatus @default(received)
  attempts      Int                @default(0)
  lastError     String?            @map("last_error")
  receivedAt    DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt   DateTime?          @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@map("payment_webhook_events")
}

enum RefundKind {
  /// Requested by a finance maker, approved by a different finance checker.
  manual
  /// Automatic full refund of a payment captured after its hold expired (Q08).
  late_capture
  /// Automatic refund when a paid order is rejected, times out or is cancelled before acceptance.
  order_cancelled
}

enum RefundStatus {
  requested
  approved
  rejected
  submitted
  succeeded
  failed
}

model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  paymentId      String       @map("payment_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  kind           RefundKind
  amountFils     BigInt       @map("amount_fils")
  currency       String       @db.Char(3)
  reason         String
  status         RefundStatus @default(requested)
  requestedById  String?      @map("requested_by") @db.Uuid
  /// The checker who approved or rejected it.
  decidedById    String?      @map("decided_by") @db.Uuid
  decisionReason String?      @map("decision_reason")
  providerKey    String       @unique @map("provider_key")
  providerRef    String?      @unique @map("provider_ref")
  failureCode    String?      @map("failure_code")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestedBy User?   @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?   @relation("RefundDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refunds")
}

/// One balanced posting. Balance is checked by the service and again by a deferred
/// database trigger at commit. Append-only.
model JournalTransaction {
  id         String   @id @default(uuid()) @db.Uuid
  sourceType String   @map("source_type")
  sourceId   String   @map("source_id") @db.Uuid
  eventType  String   @map("event_type")
  currency   String   @default("AED") @db.Char(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lines JournalLine[]

  @@unique([sourceType, sourceId, eventType])
  @@index([createdAt])
  @@map("journal_transactions")
}

model JournalLine {
  id          String   @id @default(uuid()) @db.Uuid
  journalId   String   @map("journal_id") @db.Uuid
  accountCode String   @map("account_code")
  merchantId  String?  @map("merchant_id") @db.Uuid
  debitFils   BigInt   @default(0) @map("debit_fils")
  creditFils  BigInt   @default(0) @map("credit_fils")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  journal     JournalTransaction @relation(fields: [journalId], references: [id], onDelete: Restrict)
  merchant    Merchant?          @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  allocations PayoutAllocation[]

  @@index([journalId])
  @@index([accountCode, merchantId, createdAt])
  @@map("journal_lines")
}

enum PayoutStatus {
  pending_approval
  approved
  rejected
  submitted
  paid
  failed
}

/// Sandbox payout simulation (D04 not approved). Maker and checker must differ.
model Payout {
  id             String       @id @default(uuid()) @db.Uuid
  merchantId     String       @map("merchant_id") @db.Uuid
  amountFils     BigInt       @map("amount_fils")
  currency       String       @default("AED") @db.Char(3)
  periodEnd      DateTime     @map("period_end") @db.Timestamptz(6)
  status         PayoutStatus @default(pending_approval)
  makerId        String       @map("maker_id") @db.Uuid
  checkerId      String?      @map("checker_id") @db.Uuid
  decisionReason String?      @map("decision_reason")
  providerKey    String       @unique @map("provider_key")
  providerRef    String?      @unique @map("provider_ref")
  failureCode    String?      @map("failure_code")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant    Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  maker       User               @relation("PayoutMaker", fields: [makerId], references: [id], onDelete: Restrict)
  checker     User?              @relation("PayoutChecker", fields: [checkerId], references: [id], onDelete: Restrict)
  allocations PayoutAllocation[]

  @@index([merchantId, status])
  @@map("payouts")
}

/// Which merchant earnings (journal credit lines) a payout covers. Immutable; allocations of
/// rejected or failed payouts no longer count, so the earnings become available again.
model PayoutAllocation {
  id            String @id @default(uuid()) @db.Uuid
  payoutId      String @map("payout_id") @db.Uuid
  journalLineId String @map("journal_line_id") @db.Uuid
  amountFils    BigInt @map("amount_fils")

  payout      Payout      @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  journalLine JournalLine @relation(fields: [journalLineId], references: [id], onDelete: Restrict)

  @@unique([payoutId, journalLineId])
  @@index([journalLineId])
  @@map("payout_allocations")
}

model ReconciliationRun {
  id          String   @id @default(uuid()) @db.Uuid
  periodStart DateTime @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime @map("period_end") @db.Timestamptz(6)
  startedById String?  @map("started_by") @db.Uuid
  matched     Int
  mismatched  Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  exceptions ReconciliationException[]

  @@index([createdAt])
  @@map("reconciliation_runs")
}

enum ReconciliationExceptionStatus {
  open
  resolved
}

/// A difference between our records and the provider statement. Open exceptions block
/// payouts for the merchant (or all payouts when no merchant is known).
model ReconciliationException {
  id               String                        @id @default(uuid()) @db.Uuid
  runId            String                        @map("run_id") @db.Uuid
  kind             String
  objectType       String                        @map("object_type")
  localId          String?                       @map("local_id") @db.Uuid
  providerRef      String?                       @map("provider_ref")
  merchantId       String?                       @map("merchant_id") @db.Uuid
  expected         Json
  actual           Json
  status           ReconciliationExceptionStatus @default(open)
  resolvedById     String?                       @map("resolved_by") @db.Uuid
  resolutionReason String?                       @map("resolution_reason")
  resolvedAt       DateTime?                     @map("resolved_at") @db.Timestamptz(6)
  createdAt        DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)

  run        ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Restrict)
  resolvedBy User?             @relation(fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([status, merchantId])
  @@map("reconciliation_exceptions")
}

enum CancellationRequestStatus {
  open
  approved
  declined
}

/**
 * A customer's request to cancel (D05). Before acceptance it is approved at once and the order
 * is cancelled; after acceptance it waits for operations review and never changes the order
 * or money by itself (Q12).
 */
model CancellationRequest {
  id               String                    @id @default(uuid()) @db.Uuid
  orderId          String                    @map("order_id") @db.Uuid
  userId           String                    @map("user_id") @db.Uuid
  reason           String
  /// Order status when the customer asked.
  orderStatus      OrderStatus               @map("order_status")
  status           CancellationRequestStatus @default(open)
  resolvedById     String?                   @map("resolved_by") @db.Uuid
  resolutionReason String?                   @map("resolution_reason")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order      Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user       User  @relation("CancellationRequester", fields: [userId], references: [id], onDelete: Restrict)
  resolvedBy User? @relation("CancellationResolver", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status, createdAt])
  @@map("cancellation_requests")
}

enum TicketCategory {
  order_issue
  payment
  account
  privacy
  merchant_support
  other
}

enum TicketStatus {
  open
  pending
  resolved
  closed
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

/// Who raised a ticket: a customer, or a merchant member on behalf of their merchant.
enum TicketChannel {
  customer
  merchant
}

/// Privacy requests (docs/07 POST /me/privacy-requests); handled by people, never automated (D11).
enum PrivacyRequestKind {
  access
  deletion
  correction
}

enum TicketAuthorRole {
  customer
  merchant
  support
}

enum TicketVisibility {
  public
  internal
}

/**
 * Support tickets (docs/04 A06, docs/03 support). A customer ticket may reference only the
 * customer's own order; a merchant ticket belongs to one merchant and may reference only that
 * merchant's orders. Messages are append-only; internal notes are visible to support only.
 */
model Ticket {
  id          String              @id @default(uuid()) @db.Uuid
  channel     TicketChannel
  requesterId String              @map("requester_id") @db.Uuid
  merchantId  String?             @map("merchant_id") @db.Uuid
  orderId     String?             @map("order_id") @db.Uuid
  category    TicketCategory
  privacyKind PrivacyRequestKind? @map("privacy_kind")
  status      TicketStatus        @default(open)
  priority    TicketPriority      @default(normal)
  assigneeId  String?             @map("assignee_id") @db.Uuid
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  requester User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee  User?           @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  merchant  Merchant?       @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  order     Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  messages  TicketMessage[]

  @@index([requesterId, createdAt])
  @@index([merchantId, createdAt])
  @@index([status, priority, createdAt])
  @@map("tickets")
}

model TicketMessage {
  id         String           @id @default(uuid()) @db.Uuid
  ticketId   String           @map("ticket_id") @db.Uuid
  authorId   String           @map("author_id") @db.Uuid
  authorRole TicketAuthorRole @map("author_role")
  visibility TicketVisibility @default(public)
  body       String
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

// ───────────────────────────── Platform administration ─────────────────────────────
// Cycle 2 (founder decisions 2026-11-28). Settings are typed in code; every change is
// versioned and audited. Live payments can never be switched on from here.

model PlatformSetting {
  key         String   @id
  value       Json
  version     Int      @default(1)
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  updatedBy User? @relation("SettingUpdater", fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("platform_settings")
}

enum DisputeStatus {
  open
  evidence_submitted
  won
  lost
}

/// A card dispute or chargeback reported by the payment provider (sandbox only). Who bears a
/// lost chargeback is an open commercial decision, so no journal posting is made here yet.
model Dispute {
  id          String        @id @default(uuid()) @db.Uuid
  paymentId   String        @map("payment_id") @db.Uuid
  providerRef String        @unique @map("provider_ref")
  amountFils  BigInt        @map("amount_fils")
  reason      String
  status      DisputeStatus @default(open)
  evidence    String?
  dueAt       DateTime?     @map("due_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("disputes")
}

/// In-app notification inbox. Nothing here sends SMS, email or push (no real notifications
/// without approval); delivery channels are added behind flags later.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String
  /// { "en": "...", "ar": "..." }
  title     Json
  body      Json
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("notifications")
}

// ── Phase 9: engagement (sandbox) ─────────────────────────────────────────

enum StampEventKind {
  earn
  reverse
  redeem
  release
}

/// One merchant-funded stamp card per business. Every change bumps the terms version.
model StampCard {
  id             String   @id @default(uuid()) @db.Uuid
  merchantId     String   @unique @map("merchant_id") @db.Uuid
  nameEn         String   @map("name_en")
  nameAr         String?  @map("name_ar")
  stampsRequired Int      @map("stamps_required")
  rewardEn       String   @map("reward_en")
  rewardAr       String?  @map("reward_ar")
  rewardMaxFils  BigInt   @map("reward_max_fils")
  active         Boolean  @default(true)
  termsVersion   Int      @default(1) @map("terms_version")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  events   StampEvent[]

  @@map("stamp_cards")
}

/// Running stamp balance per customer and business. Changed only together with a stamp event.
model StampAccount {
  userId     String   @map("user_id") @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  /// Can go below zero when stamps already spent are reversed by a refund (never charged).
  balance    Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@id([userId, merchantId])
  @@map("stamp_accounts")
}

/// Append-only stamp history (database trigger). At most one event of each kind per order.
model StampEvent {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  merchantId String         @map("merchant_id") @db.Uuid
  cardId     String?        @map("card_id") @db.Uuid
  orderId    String?        @map("order_id") @db.Uuid
  kind       StampEventKind
  /// Signed change to the balance.
  stamps     Int
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  card  StampCard? @relation(fields: [cardId], references: [id], onDelete: Restrict)
  order Order?     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderId, kind])
  @@index([userId, merchantId, createdAt])
  @@map("stamp_events")
}

enum PromotionStatus {
  draft
  pending_review
  approved
  rejected
  paused
  ended
}

enum PromotionKind {
  percent
  amount
}

/// Merchant-funded promo code. Usable only after an admin approves it (A07 moderation).
model Promotion {
  id                 String          @id @default(uuid()) @db.Uuid
  merchantId         String          @map("merchant_id") @db.Uuid
  code               String
  nameEn             String          @map("name_en")
  nameAr             String?         @map("name_ar")
  kind               PromotionKind
  percentBasisPoints Int?            @map("percent_basis_points")
  amountFils         BigInt?         @map("amount_fils")
  minSubtotalFils    BigInt          @default(0) @map("min_subtotal_fils")
  maxDiscountFils    BigInt?         @map("max_discount_fils")
  startsAt           DateTime        @map("starts_at") @db.Timestamptz(6)
  endsAt             DateTime        @map("ends_at") @db.Timestamptz(6)
  maxRedemptions     Int?            @map("max_redemptions")
  perCustomerLimit   Int             @default(1) @map("per_customer_limit")
  /// Held and confirmed uses; released holds give the place back.
  redemptions        Int             @default(0)
  status             PromotionStatus @default(draft)
  reviewNote         String?         @map("review_note")
  reviewedById       String?         @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  version            Int             @default(1)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant       Merchant              @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  reviewedBy     User?                 @relation("PromotionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  redemptionRows PromotionRedemption[]

  @@unique([merchantId, code])
  @@index([status, createdAt])
  @@map("promotions")
}

enum RedemptionStatus {
  held
  confirmed
  released
}

model PromotionRedemption {
  id          String           @id @default(uuid()) @db.Uuid
  promotionId String           @map("promotion_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  orderId     String           @unique @map("order_id") @db.Uuid
  status      RedemptionStatus @default(held)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([promotionId, userId])
  @@map("promotion_redemptions")
}

enum TableStatus {
  active
  retired
}

/// Dine-in table. Its QR token is signed with a server secret and carries the token version;
/// rotating bumps the version so earlier printed codes stop working.
model BranchTable {
  id           String      @id @default(uuid()) @db.Uuid
  branchId     String      @map("branch_id") @db.Uuid
  label        String
  status       TableStatus @default(active)
  tokenVersion Int         @default(1) @map("token_version")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@map("branch_tables")
}

enum GiftStatus {
  issued
  claimed
  reserved
  redeemed
  expired
}

/// Sandbox gift of one drink: an entitlement, not stored value. No payment is taken; the API
/// refuses gifts in production. The claim token is stored only as a hash and works once.
model Gift {
  id             String     @id @default(uuid()) @db.Uuid
  merchantId     String     @map("merchant_id") @db.Uuid
  productId      String     @map("product_id") @db.Uuid
  purchaserId    String     @map("purchaser_id") @db.Uuid
  recipientId    String?    @map("recipient_id") @db.Uuid
  valueFils      BigInt     @map("value_fils")
  message        String?
  claimTokenHash String     @unique @map("claim_token_hash")
  status         GiftStatus @default(issued)
  orderId        String?    @unique @map("order_id") @db.Uuid
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(6)
  claimedAt      DateTime?  @map("claimed_at") @db.Timestamptz(6)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant  Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  purchaser User     @relation("GiftPurchaser", fields: [purchaserId], references: [id], onDelete: Restrict)
  recipient User?    @relation("GiftRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([purchaserId, createdAt])
  @@index([recipientId, createdAt])
  @@map("gifts")
}

/// Fixed-window request counters for rate limiting (docs/10). Replaces Redis so the API runs
/// on serverless hosting with only PostgreSQL. Expired rows are purged by the cron tick.
model RateLimitCounter {
  key       String   @id
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("rate_limit_counters")
}
