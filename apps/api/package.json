{
  "name": "@beans/api",
  "version": "0.0.0",
  "private": true,
  "description": "Modular NestJS backend for the coffee marketplace.",
  "type": "module",
  "scripts": {
    "build": "pnpm prisma:generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/main.js",
    "dev": "pnpm prisma:generate && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "pnpm prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "pnpm prisma:generate && vitest run --project integration",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:check-migrations": "node --import tsx scripts/check-migrations.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "pnpm prisma:generate && node --env-file-if-exists=.env --import tsx prisma/seed.ts",
    "storage:setup": "node --env-file-if-exists=.env --import tsx scripts/storage-setup.ts",
    "db:demo": "pnpm prisma:generate && node --env-file-if-exists=.env --import tsx prisma/demo.ts",
    "demo:orders": "node --env-file-if-exists=.env --import tsx scripts/demo-orders.ts",
    "demo:provision": "node --env-file-if-exists=.env --import tsx scripts/provision-demo-accounts.ts"
  },
  "dependencies": {
    "@beans/contracts": "workspace:*",
    "@nestjs/common": "12.6.3",
    "@nestjs/core": "12.6.3",
    "@nestjs/platform-express": "12.6.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@vercel/functions": "3.11.2",
    "jose": "^6.2.18",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@beans/config": "workspace:*",
    "@eslint/js": "^9.39.0",
    "@nestjs/testing": "12.6.3",
    "@swc/core": "^1.16.22",
    "@types/node": "^22.19.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.0",
    "prisma": "7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.2"
  }
}
