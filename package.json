{
  "name": "beans-app",
  "version": "0.0.0",
  "private": true,
  "description": "Specialty coffee pickup marketplace for the UAE: customer app, merchant portal, branch tablet, admin console and API.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "echo \"No end-to-end tests yet: they start with the first user-facing features (phase 3+).\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @beans/api db:migrate",
    "db:seed": "echo \"No seed data yet: seeds arrive with the core schema in phase 2.\""
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
